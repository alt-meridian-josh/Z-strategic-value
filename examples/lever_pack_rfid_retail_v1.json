      "registryId": "REG-RET-CYCLECOUNT",
      "version": "v1",
      "name": "Inventory Accuracy — Cycle Count Labor",
      "theme": "Labor & Human Capacity",
      "verticalKey": "retail",
      "rampType": "hard_labor",
      "accessibilityTier": "configured",
      "haircut": 0.10,
      "technologyIds": ["rfid"],
      "techKeys": ["RFID Core", "Handheld RFID", "Fixed RFID Infrastructure"],
      "formula": "annual_count_cycles * total_sku_locations * (hours_per_sku_manual - hours_per_sku_rfid) * loaded_rate",
      "inputs": {
        "total_sku_locations": { "value": 50000, "range": [20000, 80000], "source": "GS1: typical apparel store 20K–80K", "confidence": "B" },
        "hours_per_sku_manual": { "value": 0.05, "source": "GS1: 2–5 min; use 3 min = 0.05 hr", "confidence": "B" },
        "hours_per_sku_rfid": { "value": 0.0033, "source": "GS1/Auburn: 10–15 sec; use 12 sec", "confidence": "B" },
        "loaded_rate": { "value": 24, "source": "BLS retail median + 30% burden", "confidence": "A" },
        "annual_count_cycles": { "value": 12, "source": "Monthly=12; Weekly=52", "confidence": "A" }
      },
      "evidence": [
        { "id": "EV-RET-LABOR-01", "tier": "Tier 3", "title": "Retail Labor Productivity with RFID Cycle Counting", "publisher": "GS1 US Retail Team", "year": 2023, "claim": "RFID cycle counting reduces labor per count cycle by 75–90% vs. barcode." },
        { "id": "EV-RET-ACC-01", "tier": "Tier 1", "title": "RFID: The Right Time for Retail", "publisher": "Auburn University RFID Lab", "year": 2022, "claim": "93–99% inventory accuracy vs. 65–75% without; 50+ deployments." }
      ],
      "oneLiner": "Cut cycle-count labor 75–90% — from 3 min/item to 12 sec with handheld RFID"
    },
    {
